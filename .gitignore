# ==========================================
# JobPilot AI - Root Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Python virtual environments
.venv/
venv/
env/

# Python cache and generated files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node.js dependencies and build files
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo

# Laravel dependencies
vendor/

# Laravel generated files
bootstrap/cache/*.php
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/*.key

# Keep Laravel directory structures
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

# Database files
*.sqlite
*.sqlite3
*.db

# Local uploads and generated documents
storage/app/private/*
storage/app/public/*
!storage/app/private/.gitignore
!storage/app/public/.gitignore

# IDE and operating system
.DS_Store
.idea/
.vscode/
*.swp

# Temporary files
*.tmp
*.temp
*.log

# Local test output
htmlcov/
.coverage